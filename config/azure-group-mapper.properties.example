# Copy to a server-local file, then use its absolute path in JAVA_OPTIONS.
# Match the exact Name. An omitted NameFormat means "unspecified" in SAML.
# WebLogic may expose a missing format as null or Basic; the mapper normalizes
# null to unspecified. Accept both representations for this case.
claim.name=http://schemas.microsoft.com/ws/2008/06/identity/claims/groups
claim.nameFormat=urn:oasis:names:tc:SAML:2.0:attrname-format:unspecified,urn:oasis:names:tc:SAML:2.0:attrname-format:basic
# Incoming SAML group claim value -> WebLogic group principal.
# Replace these sample names with the values used by your environment.
group.puneeth_group=puneeth_group
